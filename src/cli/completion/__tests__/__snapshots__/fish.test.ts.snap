// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emitFish > matches the snapshot 1`] = `
"# codemie completion fish — generated by codemie v9.9.9
# Install: tool completion fish | source
function __tool_state
    set -l toks (commandline -opc)
    set -e toks[1]
    set -l node 0
    set -l i 1
    set -l n (count $toks)
    while test $i -le $n
        set -l w $toks[$i]
        switch $w
            case '--'
                echo end
                return
            case '-*'
                set -l key
                switch "$node:$w"
              case '0:--task'
                set key '0:--task'
              case '1:--format'
                set key '1:--format'
              case '1:--out'
                set key '1:--out'
              case '1:--name'
                set key '1:--name'
                end
                if test -n "$key"
                    if test $i -ge $n
                        echo $key
                        return
                    end
                    set i (math $i + 1)
                end
            case '*'
                switch "$node:$w"
            case '0:list' '0:ls'
              set node 1
            case '0:a'
              set node 2
            case '0:help'
              set node 7
            case '2:b'
              set node 3
            case '2:help'
              set node 6
            case '3:c'
              set node 4
            case '3:help'
              set node 5
                end
        end
        set i (math $i + 1)
    end
    echo $node
end
complete -c tool -f
complete -c tool -n 'test (__tool_state) = \\'0\\'' -a 'list' -d 'List things (it\\'s fine)'
complete -c tool -n 'test (__tool_state) = \\'0\\'' -a 'ls' -d 'List things (it\\'s fine)'
complete -c tool -n 'test (__tool_state) = \\'0\\'' -a 'a' -d 'Group a'
complete -c tool -n 'test (__tool_state) = \\'0\\'' -a 'help' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'0\\'' -l 'version' -s 'V' -d 'output the version number'
complete -c tool -n 'test (__tool_state) = \\'0\\'' -l 'task' -d 'Run a task'
complete -c tool -n 'test (__tool_state) = \\'0\\'' -l 'help' -s 'h' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'1\\'' -l 'verbose' -s 'v' -d 'Verbose'
complete -c tool -n 'test (__tool_state) = \\'1\\'' -l 'format' -d 'Output format'
complete -c tool -n 'test (__tool_state) = \\'1:--format\\'' -f -a 'json'
complete -c tool -n 'test (__tool_state) = \\'1:--format\\'' -f -a 'text'
complete -c tool -n 'test (__tool_state) = \\'1:--format\\'' -f -a 'two\\\\ words'
complete -c tool -n 'test (__tool_state) = \\'1\\'' -l 'out' -d 'Output file'
complete -c tool -n 'test (__tool_state) = \\'1:--out\\'' -F
complete -c tool -n 'test (__tool_state) = \\'1\\'' -l 'cfg' -d 'Config file'
complete -c tool -n 'test (__tool_state) = \\'1\\'' -l 'name' -d 'Free-form value'
complete -c tool -n 'test (__tool_state) = \\'1:--name\\'' -F
complete -c tool -n 'test (__tool_state) = \\'1\\'' -l 'help' -s 'h' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'2\\'' -a 'b' -d ''
complete -c tool -n 'test (__tool_state) = \\'2\\'' -a 'help' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'2\\'' -l 'help' -s 'h' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'3\\'' -a 'c' -d ''
complete -c tool -n 'test (__tool_state) = \\'3\\'' -a 'help' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'3\\'' -l 'help' -s 'h' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'4\\'' -f -a 'red'
complete -c tool -n 'test (__tool_state) = \\'4\\'' -f -a 'green'
complete -c tool -n 'test (__tool_state) = \\'4\\'' -f -a 'two\\\\ words'
complete -c tool -n 'test (__tool_state) = \\'4\\'' -l 'deep' -d 'Deep'
complete -c tool -n 'test (__tool_state) = \\'4\\'' -l 'help' -s 'h' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'5\\'' -l 'help' -s 'h' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'6\\'' -l 'help' -s 'h' -d 'display help for command'
complete -c tool -n 'test (__tool_state) = \\'7\\'' -l 'help' -s 'h' -d 'display help for command'
"
`;

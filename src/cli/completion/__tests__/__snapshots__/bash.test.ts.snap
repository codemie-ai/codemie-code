// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emitBash > matches the snapshot 1`] = `
"# codemie completion bash — generated by codemie v9.9.9
# Install: eval "$(tool completion bash)"
_tool() {
  local cur node w i kind vals vmode words
  cur="\${COMP_WORDS[COMP_CWORD]}"
  node=0; vmode=; vals=; i=1
  while [ "$i" -lt "$COMP_CWORD" ]; do
    w="\${COMP_WORDS[i]}"
    case "$w" in
      --) vmode=x; break;;
      -*)
        kind=
        case "$node:$w" in
        '0:--task') kind=n;;
        '1:--format') kind=c; vals='json
text
two words';;
        '1:--out') kind=f;;
        '1:--name') kind=f;;
        esac
        if [ -n "$kind" ]; then
          if [ $((i + 1)) -ge "$COMP_CWORD" ]; then vmode="$kind"; break; fi
          i=$((i + 1))
        fi
        ;;
      *)
        case "$node:$w" in
        '0:list'|'0:ls') node=1;;
        '0:a') node=2;;
        '0:help') node=7;;
        '2:b') node=3;;
        '2:help') node=6;;
        '3:c') node=4;;
        '3:help') node=5;;
        esac
        ;;
    esac
    i=$((i + 1))
  done
  local IFS=$'\\n'
  case "$vmode" in
    c) COMPREPLY=( $(compgen -W "$vals" -- "$cur") );;
    f)
      COMPREPLY=( $(compgen -f -- "$cur") )
      type compopt >/dev/null 2>&1 && compopt -o filenames 2>/dev/null
      ;;
    n|x) COMPREPLY=();;
    *)
      case "$node" in
        0) words='list
ls
a
help
--version
-V
--task
--help
-h';;
        1) words='--verbose
-v
--format
--out
--cfg
--name
--help
-h';;
        2) words='b
help
--help
-h';;
        3) words='c
help
--help
-h';;
        4) words='--deep
--help
-h
red
green
two words';;
        5) words='--help
-h';;
        6) words='--help
-h';;
        7) words='--help
-h';;
      esac
      COMPREPLY=( $(compgen -W "$words" -- "$cur") )
      ;;
  esac
  return 0
}
complete -F _tool tool
"
`;

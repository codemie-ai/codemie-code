// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`emitZsh > matches the snapshot 1`] = `
"#compdef tool
# codemie completion zsh — generated by codemie v9.9.9
# Install: eval "$(tool completion zsh)"  (or save as _tool on your fpath)
_tool() {
  local node w i kind vmode
  local -a vals cmds opts
  node=0; vmode=; vals=(); i=2
  while (( i < CURRENT )); do
    w="\${words[i]}"
    case "$w" in
      -*)
        kind=
        case "$node:$w" in
          '0:--task') kind=n;;
          '1:--format') kind=c; vals=('json' 'text' 'two words');;
          '1:--out') kind=f;;
          '1:--name') kind=f;;
          '1:--task') kind=n;;
          '2:--task') kind=n;;
          '3:--task') kind=n;;
          '4:--task') kind=n;;
          '5:--task') kind=n;;
          '6:--task') kind=n;;
          '7:--task') kind=n;;
        esac
        if [[ -n "$kind" ]]; then
          if (( i + 1 >= CURRENT )); then vmode="$kind"; break; fi
          i=$(( i + 1 ))
        fi
        ;;
      *)
        case "$node:$w" in
        '0:list'|'0:ls') node=1;;
        '0:a') node=2;;
        '0:help') node=7;;
        '2:b') node=3;;
        '2:help') node=6;;
        '3:c') node=4;;
        '3:help') node=5;;
        esac
        ;;
    esac
    i=$(( i + 1 ))
  done
  case "$vmode" in
    c) compadd -- "\${vals[@]}"; return;;
    f) _files; return;;
    n) return 1;;
  esac
  case "$node" in
    0) cmds=('list:List things (it'\\''s fine)' 'ls:List things (it'\\''s fine)' 'a:Group a' 'help:display help for command'); opts=('--version:output the version number' '-V:output the version number' '--task:Run a task' '--help:display help for command' '-h:display help for command');;
    1) cmds=(); opts=('--verbose:Verbose' '-v:Verbose' '--format:Output format' '--out:Output file' '--cfg:Config file' '--name:Free-form value' '--help:display help for command' '-h:display help for command' '--version:output the version number' '-V:output the version number' '--task:Run a task');;
    2) cmds=('b' 'help:display help for command'); opts=('--help:display help for command' '-h:display help for command' '--version:output the version number' '-V:output the version number' '--task:Run a task');;
    3) cmds=('c' 'help:display help for command'); opts=('--help:display help for command' '-h:display help for command' '--version:output the version number' '-V:output the version number' '--task:Run a task');;
    4) cmds=(); opts=('--deep:Deep' '--help:display help for command' '-h:display help for command' '--version:output the version number' '-V:output the version number' '--task:Run a task');;
    5) cmds=(); opts=('--help:display help for command' '-h:display help for command' '--version:output the version number' '-V:output the version number' '--task:Run a task');;
    6) cmds=(); opts=('--help:display help for command' '-h:display help for command' '--version:output the version number' '-V:output the version number' '--task:Run a task');;
    7) cmds=(); opts=('--help:display help for command' '-h:display help for command' '--version:output the version number' '-V:output the version number' '--task:Run a task');;
  esac
  (( $#cmds )) && _describe 'command' cmds
  (( $#opts )) && _describe 'option' opts
  return 0
}
if [ "$funcstack[1]" = "_tool" ]; then
  _tool "$@"
elif (( $+functions[compdef] )); then
  compdef _tool tool
fi
"
`;

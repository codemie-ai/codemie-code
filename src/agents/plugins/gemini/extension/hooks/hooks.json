{
  "description": "CodeMie session tracking hooks for Gemini CLI",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codemie hook",
            "name": "CodeMie Session Start",
            "timeout": 60000
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codemie hook",
            "name": "CodeMie Session End (flushes pending metrics; needs headroom for the API sync)",
            "timeout": 60000
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codemie hook",
            "name": "CodeMie Stop Hook",
            "timeout": 60000
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codemie hook",
            "name": "CodeMie User Prompt Submit",
            "timeout": 60000
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codemie hook",
            "name": "CodeMie PreCompact Hook",
            "timeout": 60000
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "codemie hook",
            "name": "CodeMie Permission Request",
            "timeout": 60000
          }
        ]
      }
    ]
  }
}

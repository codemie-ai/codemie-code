+    ],
+    metrics: { tools: {} },
+  } as never;
+
+  /** Deps with NO ownership marker — the situation every Copilot session is in. */
+  function unownedDeps(agentName: string, sessionId: string, parsedSession: unknown): NativeLoaderDeps {
+    return {
+      trackedLogPaths: () => new Set<string>(),
